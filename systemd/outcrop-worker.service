[Unit]
Description=Outcrop single disk scan worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=outcrop
WorkingDirectory=/opt/outcrop
ExecStart=/usr/bin/carton exec /usr/bin/perl script/outcrop worker
UMask=0027
RuntimeDirectory=outcrop
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
KillMode=control-group
TimeoutStopSec=120
# Share the host mount namespace so residual mounts remain inspectable after
# crashes. Filesystem sandboxing and PrivateTmp would hide those mounts.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
