[Unit]
Description=Outcrop disk scan workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=outcrop
WorkingDirectory=/
ExecStart=/usr/local/bin/outcrop worker
Environment=OUTCROP_WORKER_JOBS=2
UMask=0027
RuntimeDirectory=outcrop
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
KillMode=control-group
TimeoutStopSec=120
# Share the host mount namespace so residual mounts remain inspectable after
# crashes. Filesystem sandboxing and PrivateTmp would hide those mounts.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
