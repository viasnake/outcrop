[Unit]
Description=Outcrop web interface
After=network.target outcrop-worker.service
Wants=outcrop-worker.service

[Service]
Type=forking
User=outcrop
Group=outcrop
WorkingDirectory=/
RuntimeDirectory=outcrop-web
RuntimeDirectoryMode=0750
PIDFile=/run/outcrop-web/hypnotoad.pid
Environment=HYPNOTOAD_FOREGROUND=0
ExecStart=/usr/local/bin/outcrop web
ExecReload=/bin/kill -USR2 $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=150
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/outcrop/queue /var/lib/outcrop/annotations
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
